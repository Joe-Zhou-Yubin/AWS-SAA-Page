          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dynamo_replicate" value="Active-active" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;dashed=1;strokeColor=#8C4FFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;" edge="1" source="dynamo1" target="dynamo2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s3_crr" value="CRR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;dashed=1;strokeColor=#3F8624;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;" edge="1" source="s3r1" target="s3r2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note_ga_vs_r53" value="&lt;b&gt;Global Accelerator vs Route 53 Latency Routing:&lt;/b&gt;&lt;br&gt;Route 53: DNS-based routing, subject to DNS TTL caching.&lt;br&gt;Mobile clients cache DNS → slow traffic shifts.&lt;br&gt;Global Accelerator: anycast IPs, traffic shifts in seconds.&lt;br&gt;Bypasses DNS cache. Better for blue-green deployments.&lt;br&gt;&lt;b&gt;Use both:&lt;/b&gt; Route 53 for DNS resolution, GA for routing." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1060" width="460" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note_aurora_global" value="&lt;b&gt;Aurora Global Database:&lt;/b&gt;&lt;br&gt;One writer region (us-east-1). Secondary regions are read-only.&lt;br&gt;Replication lag: typically &lt;1 second.&lt;br&gt;RPO: &lt;1 minute. RTO: &lt;1 minute (promote secondary).&lt;br&gt;&lt;b&gt;NOT the same as Multi-AZ.&lt;/b&gt;&lt;br&gt;Multi-AZ = multiple AZs in one region.&lt;br&gt;Global DB = multiple regions." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="1060" width="460" height="130" as="geometry" />
        </mxCell>
        <mxCell id="note_dynamo_global" value="&lt;b&gt;DynamoDB Global Tables:&lt;/b&gt;&lt;br&gt;Active-active: BOTH regions accept reads AND writes.&lt;br&gt;Conflict resolution: last-writer-wins (timestamp).&lt;br&gt;Built on DynamoDB Streams under the hood.&lt;br&gt;Requires on-demand or provisioned + auto-scaling.&lt;br&gt;&lt;b&gt;Exam:&lt;/b&gt; active-active NoSQL multi-region → Global Tables." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1060" width="460" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note_cost" value="&lt;b&gt;Cost Impact of Going Multi-Region:&lt;/b&gt;&lt;br&gt;Expect ~3-5× your single-region database cost.&lt;br&gt;Aurora Global: full compute in each region + replication I/O.&lt;br&gt;DynamoDB Global Tables: replicated write units × number of regions.&lt;br&gt;S3 CRR: cross-region data transfer charges apply.&lt;br&gt;&lt;b&gt;Only add regions when architecture genuinely requires it.&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1600" y="1060" width="460" height="120" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
