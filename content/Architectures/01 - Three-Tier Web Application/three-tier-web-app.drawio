        <mxCell id="note1" value="&lt;b&gt;Security Groups:&lt;/b&gt;&lt;br&gt;ALB SG: inbound 443 from 0.0.0.0/0&lt;br&gt;EC2 SG: inbound 80 from ALB SG only&lt;br&gt;Aurora SG: inbound 3306 from EC2 SG only" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;High Availability:&lt;/b&gt;&lt;br&gt;- ALB spans 2 AZs automatically&lt;br&gt;- ASG replaces unhealthy instances&lt;br&gt;- Aurora Multi-AZ: auto-failover ~30s&lt;br&gt;- ElastiCache Redis: Multi-AZ replica" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="&lt;b&gt;Cost Optimisation:&lt;/b&gt;&lt;br&gt;- EC2 Compute Savings Plan (steady tier)&lt;br&gt;- S3 Intelligent-Tiering for logs&lt;br&gt;- CloudFront reduces S3 egress costs&lt;br&gt;- NAT GW per AZ (avoids cross-AZ fees)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="340" height="100" as="geometry" />
