        <mxCell id="note-scp" value="&lt;b&gt;SCPs vs IAM — Key Distinction:&lt;/b&gt;&lt;br&gt;SCPs set the MAXIMUM permissions ceiling for an account.&lt;br&gt;They do NOT grant permissions — IAM policies still required.&lt;br&gt;An SCP Deny overrides ANY IAM Allow, including root.&lt;br&gt;SCPs are managed in the Management Account only.&lt;br&gt;Member accounts cannot modify or remove SCPs." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#ffcccc;strokeColor=#DD344C;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="540" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note-accounts" value="&lt;b&gt;Why Separate Accounts?&lt;/b&gt;&lt;br&gt;Blast radius isolation: a prod security incident cannot affect dev.&lt;br&gt;Billing separation: cost allocation per team/project without tags.&lt;br&gt;Policy isolation: stricter SCPs on prod, looser on sandbox.&lt;br&gt;Service quotas: each account has independent limits.&lt;br&gt;Regulatory: some compliance frameworks require account separation." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="1000" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note-identity" value="&lt;b&gt;IAM Identity Center (SSO):&lt;/b&gt;&lt;br&gt;Single login → access any account via permission sets.&lt;br&gt;Integrates with corporate IdP (Okta, Azure AD, etc.) via SAML.&lt;br&gt;Permission sets = reusable IAM policies per role.&lt;br&gt;Users never have long-term IAM users in workload accounts.&lt;br&gt;All access via short-lived session credentials." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1000" width="540" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note-delegated" value="&lt;b&gt;Delegated Admin Pattern:&lt;/b&gt;&lt;br&gt;Security tooling (GuardDuty, Security Hub, Inspector, Macie)&lt;br&gt;runs from the Audit Account, NOT the Management Account.&lt;br&gt;Management Account should have minimal resources.&lt;br&gt;Delegated admin account sees findings across all member accounts." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1860" y="1000" width="540" height="110" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
