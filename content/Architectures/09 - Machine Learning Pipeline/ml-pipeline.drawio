        <mxCell id="note-sagemaker" value="&lt;b&gt;SageMaker Training — Spot Instances:&lt;/b&gt;&lt;br&gt;ML training jobs are often long-running (hours) and checkpoint progress.&lt;br&gt;Spot instances for training = up to 90% cost reduction.&lt;br&gt;SageMaker handles checkpointing + automatic spot retry.&lt;br&gt;Not suitable for inference endpoints (must be always-on)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note-endpoints" value="&lt;b&gt;Real-time vs Batch Inference:&lt;/b&gt;&lt;br&gt;SageMaker Endpoint: real-time, synchronous, always-on, auto-scales.&lt;br&gt;Suitable for: fraud detection, recommendations, search ranking.&lt;br&gt;SageMaker Batch Transform: asynchronous, S3 in → S3 out.&lt;br&gt;Suitable for: nightly score refresh, bulk classification, testing.&lt;br&gt;Batch is much cheaper — no always-on endpoint cost." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="880" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note-glue-emr" value="&lt;b&gt;Glue vs EMR for Preprocessing:&lt;/b&gt;&lt;br&gt;AWS Glue: serverless Spark, managed, no cluster to size.&lt;br&gt;Good for: standard ETL, moderate dataset sizes.&lt;br&gt;Amazon EMR: managed Hadoop/Spark cluster, full control.&lt;br&gt;Good for: very large datasets, custom libraries, GPU/ML frameworks.&lt;br&gt;EMR Spot instances reduce cluster cost by 60-80%." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1240" y="880" width="540" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note-orchestration" value="&lt;b&gt;Pipeline Orchestration:&lt;/b&gt;&lt;br&gt;Step Functions: orchestrate Glue → SageMaker → conditional deploy.&lt;br&gt;Amazon MWAA (Airflow): DAG-based, better for data teams,&lt;br&gt;complex dependencies, backfill, schedule management.&lt;br&gt;SageMaker Pipelines: native ML CI/CD, model registry integration." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1840" y="880" width="540" height="110" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
