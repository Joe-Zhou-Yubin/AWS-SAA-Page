        </mxCell>

        <mxCell id="e-waf2-cloudfront" value="WAF rules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=11;" edge="1" parent="1" source="waf2" target="cloudfront">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note-serverless" value="&lt;b&gt;Why Serverless?&lt;/b&gt;&lt;br&gt;- Lambda scales 0 → 1000 concurrency automatically&lt;br&gt;- Aurora Serverless v2: fine-grained ACU scaling, no idle cost&lt;br&gt;- DynamoDB On-Demand: pay per request for spiky traffic&lt;br&gt;- No EC2 / patching / capacity planning required" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="400" height="100" as="geometry" />
        </mxCell>

        <mxCell id="note-auth" value="&lt;b&gt;Auth Flow:&lt;/b&gt;&lt;br&gt;1. User signs in via Cognito User Pool&lt;br&gt;2. Cognito returns JWT (access token)&lt;br&gt;3. Client sends JWT in Authorization header&lt;br&gt;4. API Gateway validates JWT against Cognito&lt;br&gt;5. Lambda receives verified identity context" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="400" height="110" as="geometry" />
        </mxCell>

        <mxCell id="note-rds-proxy" value="&lt;b&gt;Why RDS Proxy?&lt;/b&gt;&lt;br&gt;Lambda can spawn thousands of concurrent executions.&lt;br&gt;Each opens a DB connection. Without RDS Proxy,&lt;br&gt;Aurora hits its connection limit and starts rejecting.&lt;br&gt;RDS Proxy pools connections, queues Lambda requests,&lt;br&gt;and handles failover transparently." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="930" width="400" height="120" as="geometry" />
        </mxCell>

        <mxCell id="note-dynamo-vs-aurora" value="&lt;b&gt;Aurora Serverless vs DynamoDB:&lt;/b&gt;&lt;br&gt;Aurora Serverless v2 → when you need SQL, joins,&lt;br&gt;existing relational schema. Scales in ACU increments.&lt;br&gt;DynamoDB On-Demand → pure key-value/document,&lt;br&gt;no cold start DB connections, sub-10ms at any scale.&lt;br&gt;Choose based on your access patterns." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1070" width="400" height="120" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
