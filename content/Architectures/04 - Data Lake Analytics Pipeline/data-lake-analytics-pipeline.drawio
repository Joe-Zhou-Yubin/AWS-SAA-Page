        <mxCell id="note_kinesis" value="&lt;b&gt;Streams vs Firehose vs Analytics:&lt;/b&gt;&lt;br&gt;Data Streams: custom consumers, replay, multiple readers&lt;br&gt;Firehose: managed delivery to S3/Redshift/OpenSearch (no custom code)&lt;br&gt;Analytics: real-time SQL/Flink on top of a stream&lt;br&gt;&lt;b&gt;Exam:&lt;/b&gt; &quot;multiple consumers + replay&quot; → Streams&lt;br&gt;&quot;load to S3 with no ops&quot; → Firehose" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="620" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note_parquet" value="&lt;b&gt;Why Parquet + Partitioning for Athena:&lt;/b&gt;&lt;br&gt;Athena charges per TB scanned. Parquet is columnar —&lt;br&gt;queries skip unneeded columns (80-90% less data scanned).&lt;br&gt;Partitioning by date/region lets Athena skip entire S3 prefixes.&lt;br&gt;&lt;b&gt;Exam answer for &quot;reduce Athena cost&quot;:&lt;/b&gt;&lt;br&gt;Convert to Parquet + partition the data." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="940" y="620" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note_athena_vs_redshift" value="&lt;b&gt;Athena vs Redshift:&lt;/b&gt;&lt;br&gt;Athena: serverless, pay-per-query, ad-hoc exploration&lt;br&gt;Redshift: provisioned warehouse, high-concurrency BI&lt;br&gt;Redshift Spectrum: query S3 directly from Redshift&lt;br&gt;&lt;b&gt;Exam:&lt;/b&gt; &quot;infrequent queries, no ops&quot; → Athena&lt;br&gt;&quot;complex BI, consistent low latency&quot; → Redshift" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1740" y="200" width="440" height="120" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
