        </mxCell>
        <mxCell id="note2" value="On disaster:&lt;br&gt;1. Promote RDS replica to standalone writer&lt;br&gt;2. Run CloudFormation to spin up web/app tier&lt;br&gt;3. Update Route 53 DNS&lt;br&gt;→ 10-30 minutes to recover" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#ffe6cc;strokeColor=#ED7100;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="745" y="450" width="530" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e_rds_rep2" value="async replication" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;dashed=1;strokeColor=#8C4FFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=10;" edge="1" source="rds_2p" target="rds_2dr" parent="1">
