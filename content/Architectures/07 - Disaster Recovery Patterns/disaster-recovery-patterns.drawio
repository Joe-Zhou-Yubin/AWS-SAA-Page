        <mxCell id="title" value="&lt;b&gt;AWS Disaster Recovery Strategies — Four-Pattern Comparison&lt;/b&gt;&lt;br&gt;SAA-C03 Study Vault | Architecture 07 | v1.0" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;spacing=8;" vertex="1" parent="1">
