        <mxCell id="comparison" value="&lt;b&gt;Strategy Comparison&lt;/b&gt;" style="text;html=1;align=center;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="2720" height="30" as="geometry" />
        </mxCell>
        <mxCell id="table" value="&lt;table style=&apos;width:100%;border-collapse:collapse;font-size:12px;&apos;&gt;&lt;tr style=&apos;background:#232F3E;color:white;&apos;&gt;&lt;th style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;Strategy&lt;/th&gt;&lt;th style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;RTO&lt;/th&gt;&lt;th style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;RPO&lt;/th&gt;&lt;th style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;DR Region has...&lt;/th&gt;&lt;th style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;Recovery action&lt;/th&gt;&lt;th style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;Relative cost&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;font-weight:bold;color:#DD344C;&apos;&gt;Backup &amp;amp; Restore&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;Hours&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;Hours&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;Backups in S3 only&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;Deploy IaC + restore from snapshot&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;$ (cheapest)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;font-weight:bold;color:#ED7100;&apos;&gt;Pilot Light&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;10–30 min&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;Minutes&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;DB replica running; app tier stopped&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;Promote DB + deploy app tier via IaC&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;$$ &lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;font-weight:bold;color:#8C4FFF;&apos;&gt;Warm Standby&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;Minutes&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;Seconds&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;Full stack scaled down (min instances)&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;Scale up ASG + promote DB + update DNS&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;$$$&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;font-weight:bold;color:#3F8624;&apos;&gt;Active-Active&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;&amp;lt;30s (GA)&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;Near-zero&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;Full production stack running&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;GA + Route 53 route to healthy region&lt;/td&gt;&lt;td style=&apos;padding:8px;border:1px solid #ccc;&apos;&gt;$$$$ (most expensive)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#232F3E;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="2720" height="200" as="geometry" />
        </mxCell>
        <mxCell id="trap1" value="&lt;b&gt;Exam Trap:&lt;/b&gt; Warm Standby vs Pilot Light&lt;br&gt;Pilot Light = only the core DB/critical services running in DR, rest must be started.&lt;br&gt;Warm Standby = FULL stack running but at reduced capacity. Scale up on DR.&lt;br&gt;Key question: is the app tier running in DR? Yes = Warm Standby. No = Pilot Light." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="700" height="100" as="geometry" />
        </mxCell>
        <mxCell id="trap2" value="&lt;b&gt;Exam Trap:&lt;/b&gt; Backups alone ≠ low RTO&lt;br&gt;Data is safe but infrastructure rebuild is slow without IaC.&lt;br&gt;Best practice: always pair backups with CloudFormation/CDK templates&lt;br&gt;in the DR region so infra rebuild is automated, not manual." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="1040" width="640" height="100" as="geometry" />
        </mxCell>
        <mxCell id="trap3" value="&lt;b&gt;Exam Trap:&lt;/b&gt; AWS Backup for centralised policy&lt;br&gt;Use AWS Backup to manage backup policies across EBS, RDS,&lt;br&gt;EFS, DynamoDB, S3, EC2 in ONE central policy across accounts.&lt;br&gt;Do not configure separate backup schedules per service." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1460" y="1040" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="trap4" value="&lt;b&gt;RTO vs RPO:&lt;/b&gt;&lt;br&gt;RPO = how much data you can lose (measured in time before disaster).&lt;br&gt;RTO = how long it takes to be back online.&lt;br&gt;Shorter RPO → more frequent backups / synchronous replication.&lt;br&gt;Shorter RTO → more infrastructure pre-provisioned in DR region." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2100" y="1040" width="640" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
