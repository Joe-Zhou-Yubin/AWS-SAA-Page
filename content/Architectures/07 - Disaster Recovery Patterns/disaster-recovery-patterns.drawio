          <mxGeometry x="2310" y="220" width="65" height="65" as="geometry" />
        </mxCell>
        <mxCell id="note4" value="On disaster: Route 53 + Global Accelerator&lt;br&gt;detects failure and routes ALL traffic to Region B.&lt;br&gt;DynamoDB Global Tables: already active.&lt;br&gt;RTO: &lt;30s (GA) to minutes (DNS TTL).&lt;br&gt;Most expensive — full duplicate stack." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#3F8624;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2065" y="450" width="630" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e_dynamo_4" value="active-active" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;dashed=1;strokeColor=#8C4FFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=10;" edge="1" source="dynamo_4a" target="dynamo_4b" parent="1">
