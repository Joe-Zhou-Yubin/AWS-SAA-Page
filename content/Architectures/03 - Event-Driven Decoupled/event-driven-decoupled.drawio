        </mxCell>

        <mxCell id="note_fanout" value="&lt;b&gt;Why SNS fan-out to separate SQS queues?&lt;/b&gt;&lt;br&gt;Each consumer gets its own independent copy of the message.&lt;br&gt;- Fulfillment can process slowly without blocking Email&lt;br&gt;- Email failure doesn&apos;t affect Analytics&lt;br&gt;- Each queue has its own DLQ, retry policy, scaling&lt;br&gt;A single shared SQS queue = competing consumers (only one gets each message)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note_dlq" value="&lt;b&gt;DLQ Pattern:&lt;/b&gt;&lt;br&gt;maxReceiveCount = 3 on the source queue.&lt;br&gt;After 3 failed processing attempts,&lt;br&gt;message moved to DLQ automatically.&lt;br&gt;CloudWatch Alarm fires when DLQ depth &gt; 0.&lt;br&gt;SNS alerts ops team for investigation." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note_scaling" value="&lt;b&gt;ASG + SQS Scaling (Target Tracking):&lt;/b&gt;&lt;br&gt;Metric: ApproximateNumberOfMessages ÷ InService instances&lt;br&gt;Target: acceptable backlog per instance (e.g. 10 msgs/instance)&lt;br&gt;ASG scales out when backlog exceeds target.&lt;br&gt;Scales in when queue drains." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="420" height="110" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
