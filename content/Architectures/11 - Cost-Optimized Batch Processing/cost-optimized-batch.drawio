        <mxCell id="note-spot" value="&lt;b&gt;Spot for Batch — Why It Works:&lt;/b&gt;&lt;br&gt;Batch jobs are fault-tolerant: they checkpoint progress and can retry.&lt;br&gt;Spot Instances can be reclaimed with 2-minute warning.&lt;br&gt;EC2 Spot Fleet: diversifies across instance types + AZs, maintains&lt;br&gt;target capacity automatically after interruption.&lt;br&gt;Fargate Spot: same idea, containerised — no EC2 to manage.&lt;br&gt;Cost saving: 60-90% vs On-Demand for the compute tier." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#ffe6cc;strokeColor=#ED7100;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1100" width="560" height="140" as="geometry" />
        </mxCell>
        <mxCell id="note-s3cost" value="&lt;b&gt;S3 Storage Cost Optimisation:&lt;/b&gt;&lt;br&gt;Output data lifecycle policy (applied automatically):&lt;br&gt;Day 0: S3 Standard (active queries)&lt;br&gt;Day 30: S3 Standard-IA (infrequent access, retrieval fee)&lt;br&gt;Day 90: S3 Glacier Flexible Retrieval (archive, minutes retrieval)&lt;br&gt;Day 365: S3 Glacier Deep Archive (long retention, 12hr retrieval)&lt;br&gt;No action needed — lifecycle policy does it automatically." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="1100" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="note-endpoints" value="&lt;b&gt;Gateway Endpoints — Free NAT Elimination:&lt;/b&gt;&lt;br&gt;Batch compute in private subnets would normally use NAT Gateway&lt;br&gt;to reach S3 and DynamoDB → $0.045/GB processed.&lt;br&gt;S3 Gateway Endpoint + DynamoDB Gateway Endpoint:&lt;br&gt;Free route-table entries → traffic stays on AWS network.&lt;br&gt;At high S3/DynamoDB batch volumes, this saves significantly.&lt;br&gt;Only covers S3 + DynamoDB. SSM/Secrets Manager need Interface Endpoints." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1100" width="600" height="150" as="geometry" />
        </mxCell>
        <mxCell id="note-compute" value="&lt;b&gt;Choosing Batch Compute:&lt;/b&gt;&lt;br&gt;Lambda: tasks &lt;15 min, event-driven, no infra — cheapest for small jobs.&lt;br&gt;Fargate Spot: containerised, &lt;2 hrs, no EC2 to manage.&lt;br&gt;EC2 Spot Fleet: long jobs, custom instance types, GPU.&lt;br&gt;AWS Batch: managed job queues, retries, dependencies — wraps Spot/On-Demand.&lt;br&gt;EMR Spot: large-scale Spark/Hadoop, 60-80% cost reduction." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1940" y="1100" width="560" height="150" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
