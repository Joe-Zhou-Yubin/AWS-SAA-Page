          <mxGeometry x="780" y="270" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="r53out" value="Route 53 Resolver&lt;br&gt;Outbound Endpoint" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53_resolver;" vertex="1" parent="vpc1">
          <mxGeometry x="900" y="270" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="edge_dx" value="Direct Connect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;" edge="1" source="onprem" target="vgw1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_vpn" value="Site-to-Site VPN (backup)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;dashed=1;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;" edge="1" source="onprem" target="vgw1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_vgw_vpc" value="VGW Attachment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;" edge="1" source="vgw1" target="vpc1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_ec2_rds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="ec2a" target="rds1" parent="subnet1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_ec2b_rds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" source="ec2b" target="rds1" parent="subnet1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_sgw_s3" value="File Gateway writes to S3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;dashed=1;strokeColor=#3F8624;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=11;" edge="1" source="stogw1" target="s3_1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="319" y="1060" />
              <mxPoint x="1999" y="1060" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_r53_dns" value="DNS forwarding" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;dashed=1;strokeColor=#8C4FFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=11;startArrow=none;endArrow=block;" edge="1" source="r53out" target="dns1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2119" y="1120" />
              <mxPoint x="600" y="1120" />
              <mxPoint x="600" y="529" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="s3ep" value="S3 Gateway Endpoint&lt;br&gt;&lt;font style=&apos;font-size:10px&apos;&gt;Free, no NAT needed&lt;br&gt;for private S3 access&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.endpoint;" vertex="1" parent="vpc1">
          <mxGeometry x="780" y="500" width="65" height="65" as="geometry" />
        </mxCell>

        <mxCell id="dxgw" value="Direct Connect Gateway&lt;br&gt;&lt;font style=&apos;font-size:10px&apos;&gt;Connects 1 DX to&lt;br&gt;multiple regions&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.direct_connect;" vertex="1" parent="1">
          <mxGeometry x="820" y="290" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="edge_dxgw_vgw" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dxgw" target="vgw1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_onprem_dxgw" value="Direct Connect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;" edge="1" source="onprem" target="dxgw" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_s3ep_s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s3ep" target="s3_1" parent="vpc1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_ec2_s3ep" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ec2a" target="s3ep" parent="vpc1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note_dx_vs_vpn" value="&lt;b&gt;Direct Connect vs Site-to-Site VPN:&lt;/b&gt;&lt;br&gt;DX: dedicated physical circuit, consistent latency, high bandwidth&lt;br&gt;Takes weeks to provision. Not encrypted by default.&lt;br&gt;VPN: encrypted IPSec over internet, sets up in hours.&lt;br&gt;Variable latency (internet-dependent).&lt;br&gt;&lt;b&gt;Best practice:&lt;/b&gt; DX as primary, VPN as encrypted backup.&lt;br&gt;BGP metrics prefer DX — VPN activates automatically on DX failure." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="480" height="140" as="geometry" />
        </mxCell>
        <mxCell id="note_dxgw" value="&lt;b&gt;Direct Connect Gateway:&lt;/b&gt;&lt;br&gt;Connects ONE Direct Connect to VPCs in MULTIPLE AWS regions.&lt;br&gt;Without DX GW: need a separate DX per region.&lt;br&gt;With DX GW: one physical DX → VPCs in us-east-1, eu-west-1, etc.&lt;br&gt;&lt;b&gt;Limitation:&lt;/b&gt; does NOT route VPC-to-VPC traffic.&lt;br&gt;Use Transit Gateway for VPC-to-VPC + on-premises routing." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="880" width="460" height="140" as="geometry" />
        </mxCell>
        <mxCell id="note_r53" value="&lt;b&gt;Route 53 Resolver Endpoints:&lt;/b&gt;&lt;br&gt;Outbound Endpoint: VPC DNS forwards queries for&lt;br&gt;on-premises domains to on-premises DNS server.&lt;br&gt;(VPC → resolves corp.example.com)&lt;br&gt;Inbound Endpoint: on-premises DNS forwards&lt;br&gt;AWS private hosted zone queries to AWS Resolver.&lt;br&gt;(On-prem → resolves internal.aws.example.com)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1100" y="880" width="460" height="140" as="geometry" />
        </mxCell>
        <mxCell id="note_s3ep" value="&lt;b&gt;S3 Gateway Endpoint:&lt;/b&gt;&lt;br&gt;Free route-table entry. Private subnet EC2 → S3&lt;br&gt;without going through NAT Gateway.&lt;br&gt;Eliminates NAT GW data processing charges for S3 traffic.&lt;br&gt;Same for DynamoDB Gateway Endpoint.&lt;br&gt;&lt;b&gt;Only covers S3 + DynamoDB.&lt;/b&gt;&lt;br&gt;Everything else (Secrets Manager, SSM) needs Interface Endpoints." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1620" y="880" width="460" height="140" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
