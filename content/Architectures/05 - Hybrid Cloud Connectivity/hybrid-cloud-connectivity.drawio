<mxfile host="app.diagrams.net">
  <diagram id="hybrid-cloud-overview" name="Hybrid Cloud Connectivity">
    <mxGraphModel dx="2800" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="2500" height="1300" as="geometry" />
        </mxCell>
        <mxCell id="title" value="&lt;b&gt;Hybrid Cloud Connectivity&lt;/b&gt;&lt;br&gt;On-Premises to AWS via Direct Connect + Site-to-Site VPN Backup&lt;br&gt;SAA-C03 Study Vault | v1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="640" height="80" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Edge Legend&lt;/b&gt;&lt;br&gt;&#8212;&#8212; Solid black: Direct Connect (primary path)&lt;br&gt;- - - Dashed black: Site-to-Site VPN (backup path)&lt;br&gt;- - - Dashed purple: DNS forwarding rule&lt;br&gt;- - - Dashed green: File Gateway async write" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacing=6;fillColor=#FFFFFF;strokeColor=#5A6C86;" vertex="1" parent="1">
          <mxGeometry x="1980" y="30" width="480" height="110" as="geometry" />
        </mxCell>

